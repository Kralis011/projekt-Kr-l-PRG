@model Kral_InvApp.Entities.Investment

<h2 class="page-title">✏️ Upravit investici</h2>

<div class="form-card">

    <form asp-action="Edit" method="post">

        <input type="hidden" asp-for="InvestmentId" />
        <input type="hidden" name="portfolioId" value="@ViewBag.PortfolioId" />

        <div class="form-group">
            <label>Asset</label>
            <input asp-for="AssetName" class="form-control-custom" />
        </div>

        <div class="form-group">
            <label>Typ</label>
            <input asp-for="AssetType" class="form-control-custom" />
        </div>

        <div class="form-group">
            <label>Množství</label>
            <input asp-for="Amount" class="form-control-custom" />
        </div>

        <div class="form-group">
            <label>Nákupní cena</label>
            <input asp-for="BuyPrice" class="form-control-custom" />
        </div>

        <div class="form-group">
            <label>Prodejní cena</label>
            <input asp-for="SellPrice" class="form-control-custom" />
        </div>

        <div class="form-group">
            <label>Datum</label>
            <input asp-for="TradeDate" type="date" class="form-control-custom" />
        </div>

        <div class="form-buttons">
            <button type="submit" class="btn btn-success">
                💾 Uložit změny
            </button>

            <a asp-action="Index"
               asp-route-portfolioId="@ViewBag.PortfolioId"
               class="btn btn-outline-light">
                Zpět
            </a>
        </div>

    </form>

</div>
