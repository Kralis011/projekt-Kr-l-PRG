<div class="chart-wrapper">
    <canvas id="chart"></canvas>
</div>


<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<script>
    var labels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(ViewBag.Labels));
    var investedValues = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(ViewBag.InvestedValues));
    var currentValues = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(ViewBag.CurrentValues));
        var labels = @Html.Raw(Json.Serialize(ViewBag.Labels));
    var investedValues = @Html.Raw(Json.Serialize(ViewBag.InvestedValues));
    var currentValues = @Html.Raw(Json.Serialize(ViewBag.CurrentValues));


     new Chart(document.getElementById("chart"), {
        type: 'line',
        data: {
            labels: labels,
            datasets: [
                {
                    label: 'Investováno',
                    data: investedValues,
                    borderColor: '#4e73df',
                    backgroundColor: 'transparent',
                    tension: 0.3
                },
                {
                    label: 'Aktuální hodnota',
                    data: currentValues,
                    borderColor: '#1cc88a',
                    backgroundColor: 'transparent',
                    tension: 0.3
                }
            ]
        },
        options: {
            responsive: true,
            maintainAspectRatio: false
        }
    });


</script>
