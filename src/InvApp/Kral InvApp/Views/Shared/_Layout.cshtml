<!DOCTYPE html>
<html lang="cs">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Kral_InvApp</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>

<body>

    <header>
        <nav class="navbar navbar-expand-lg navbar-dark custom-navbar px-4">
            <a class="navbar-brand fw-bold" asp-controller="Home" asp-action="Index">
                💼 Kral_InvApp
            </a>

            <div class="ms-auto d-flex gap-2">
                <a asp-controller="Home" asp-action="Index"
                   class="btn btn-outline-light btn-sm">
                    Dashboard
                </a>

                <a asp-controller="Portfolio" asp-action="Index"
                   class="btn btn-outline-info btn-sm">
                    Portfolia
                </a>

                <a asp-controller="Account" asp-action="Logout"
                   class="btn btn-danger btn-sm">
                    Logout
                </a>
            </div>
        </nav>
    </header>

    <div class="container-fluid px-5 py-4">
        @RenderBody()
    </div>

    <footer class="text-center text-muted py-4">
        © 2026 - Kral_InvApp
    </footer>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>
