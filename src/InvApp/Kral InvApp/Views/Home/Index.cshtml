@model Kral_InvApp.Entities.User
<h2 class="mb-4">📊 Dashboard</h2>

<div class="row">
    <div class="col-md-3">
        <div class="card p-3 text-center">
            <h6>📁 Portfolia</h6>
            <strong>@ViewBag.PortfolioCount</strong>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card p-3 text-center">
            <h6>📌 Investice</h6>
            <strong>@ViewBag.InvestmentCount</strong>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card p-3 text-center">
            <h6>💰 Investováno</h6>
            <strong>@ViewBag.Invested Kč</strong>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card p-3 text-center">
            <h6>📈 Zisk / Ztráta</h6>
            <strong class="@(ViewBag.Profit >= 0 ? "text-success" : "text-danger")">
                @ViewBag.Profit Kč
            </strong>
        </div>
    </div>
</div>
